# Server-side only. Never expose this value through a NEXT_PUBLIC_ variable.
AI_API_KEY=

# Production default: DeepSeek's OpenAI-compatible API. Keep the provider
# configurable so Qwen or OpenAI can be evaluated without changing the UI.
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash

# Invite-only beta. Use unique codes per tester, separated by commas.
INVITE_CODES=
SESSION_SECRET=

# Encrypts the local data snapshot before it reaches disk or TOS.
DATA_ENCRYPTION_KEY=
DATA_DIR=/tmp/guanxiang-data

# veFaaS public origin and deployment metadata.
SITE_URL=
APP_VERSION=beta-1
PAYMENT_PROVIDER=disabled
RATE_LIMIT_SALT=

# Private TOS bucket in the same region as veFaaS. Use a least-privilege key.
TOS_ENDPOINT=https://tos-s3-cn-beijing.volces.com
TOS_REGION=cn-beijing
TOS_BUCKET=
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_BACKUP_PREFIX=guanxiang/backups
TOS_BACKUP_INTERVAL_SECONDS=900
