<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.guanxiang.dev</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/npm</string>
    <string>run</string>
    <string>dev</string>
    <string>--</string>
    <string>--port</string>
